# AWS RDS / MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civicfix_db
DB_USERNAME=root
DB_PASSWORD=your_password

# Or full JDBC URL for AWS RDS:
# SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint.cxxxxx.ap-south-1.rds.amazonaws.com:3306/civicfix_db?useSSL=true&requireSSL=false&serverTimezone=UTC

# Amazon S3 Cloud File Storage (for civic complaint images)
# When set, photos are stored in AWS S3 and served via public S3 URLs
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# When running on EC2/ECS/Beanstalk with IAM Role, leave access key & secret key empty!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local Upload Directory fallback
FILE_UPLOAD_DIR=./uploads/

# Google Gemini Vision AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*
PORT=8080
